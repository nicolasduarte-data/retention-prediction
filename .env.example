# .env.example — retention-prediction
#
# Copy this file to `.env` and fill in your values. `.env` is gitignored;
# `.env.example` is committed as the documentation contract for fresh-clone
# reviewers.
#
# Load with `direnv`, `python-dotenv`, or `uv run --env-file .env <cmd>`.

# ---------------------------------------------------------------------------
# BigQuery configuration
# ---------------------------------------------------------------------------
# All BQ_* vars have sensible defaults baked into `retention.config` — set
# these only if you're running against a different GCP project or dataset.

BQ_PROJECT_ID=pa-warehouse-prod
BQ_DATASET_MARTS=marts
BQ_DATASET_STAGING=staging
BQ_TABLE_ATTRITION_FEATURES=v_attrition_features
BQ_TABLE_ATTRITION_PREDICTIONS=v_attrition_predictions

# ---------------------------------------------------------------------------
# Service account key
# ---------------------------------------------------------------------------
# Absolute path to a Google Cloud service account JSON. The SA needs:
#   - BigQuery Data Viewer on the marts dataset (read v_attrition_features)
#   - BigQuery Data Editor on the marts dataset (write v_attrition_predictions
#     during Epic 8 writeback)
#   - BigQuery Job User on the project
#
# Default if unset: ~/.gcp/pa-warehouse-sa.json (cross-platform via Path.home())

PA_WAREHOUSE_SA_KEY=/path/to/pa-warehouse-sa.json

# ---------------------------------------------------------------------------
# Reproducibility
# ---------------------------------------------------------------------------
# `set_global_seed()` in retention.config seeds random + numpy for the current
# process. But Python's `hash(str)` randomization can only be controlled BEFORE
# interpreter startup. Set this in the shell before invoking uv/python:
#   PYTHONHASHSEED=42 uv run pytest
# See src/retention/config.py:set_global_seed docstring for full envelope.

PYTHONHASHSEED=42
